			fadeList(contentItems, isOpen and 0 or 1, true)

			task.delay(TWEEN_INFO.Time + 0.05, function()
				for _, entry in ipairs(gateEntries) do
					local index = table.find(shellItems, entry)
					if index then
						table.remove(shellItems, index)
					end
				end
				box:Destroy()
				introLabel:Destroy()
				linkButton:Destroy()
				errorLabel:Destroy()
			end)
		end

		box.FocusLost:Connect(function(enterPressed)
			if finished or not enterPressed then return end

			local entered = box.Text:match("^%s*(.-)%s*$")
			flashId += 1

			if validKeys[entered] == true then
				finished = true
				errorLabel.Text = ""
				box.TextEditable = false
				setOutline(SUCCESS_COLOR, SUCCESS_SHINE)
				task.delay(1, openGui)
			else
				local myId = flashId
				errorLabel.Text = "Incorrect key. Access denied."
				box.Text = ""
				setOutline(FLASH_COLOR, FLASH_COLOR)

				task.delay(1, function()
					if flashId == myId and not finished then
						refreshOutline()
					end
				end)

				task.defer(function()
					if box.Parent then
						box:CaptureFocus()
					end
				end)
			end
		end)

		task.defer(function()
			if box.Parent then
				box:CaptureFocus()
			end
		end)
	end

	createKeyGate()

	fadeList(contentItems, 1, false)
	applyState(false, false)
	applyState(true, true)
end
