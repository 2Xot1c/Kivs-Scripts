	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.ZIndex = 3
	hit.Parent = area

	local function setValue(value, silent)
		if not hideMarker and math.abs(value - defaultValue) <= 1.5 then
			value = defaultValue
		end
		local alpha = (value - minValue) / range
		knob.Position = UDim2.new(alpha, 0, 0, 16)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		valueLabel.Text = tostring(value)
		if not silent then
			callback(value)
		end
	end

	local function updateFromX(x)
		local alpha = math.clamp((x - area.AbsolutePosition.X) / area.AbsoluteSize.X, 0, 1)
		setValue(math.floor(minValue + alpha * range + 0.5), false)
	end

	valueLabel.Text = tostring(defaultValue)

	local sliding = false

	hit.InputBegan:Connect(function(input)
		if isPressTypeInput(input) then
			sliding = true
			updateFromX(input.Position.X)

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and isMoveTypeInput(input) then
			updateFromX(input.Position.X)
		end
	end)

	return function(value)
		setValue(value, true)
	end
end

