local canSave = false
local hasSavedStyle = false
local writeSavedStyle
local deleteSavedStyle
local copyInvite

do
	local HttpService = game:GetService("HttpService")
	local writeFile = writefile
	local readFile = readfile
	local isFile = isfile
	local deleteFile = delfile
	local copyToClipboard = setclipboard or toclipboard

	canSave = writeFile ~= nil and readFile ~= nil and isFile ~= nil

	local function readSavedStyle()
		if not canSave then
			return nil
		end

		local ok, decoded = pcall(function()
			if not isFile(SAVE_FILE) then
				return nil
			end
			return HttpService:JSONDecode(readFile(SAVE_FILE))
		end)

		if not ok or type(decoded) ~= "table" then
			return nil
		end

		local colors = {}
		for _, field in ipairs(CUSTOM_FIELDS) do
			local hex = decoded[field.key]
			if type(hex) ~= "string" then
				return nil
			end
			local valid, color = pcall(Color3.fromHex, hex)
			if not valid then
				return nil
			end
			colors[field.key] = color
		end

		return colors, decoded.gradient ~= false
	end

	writeSavedStyle = function()
		if not canSave then
			return false
		end

		local data = { gradient = CUSTOM_THEME.gradient }
		for _, field in ipairs(CUSTOM_FIELDS) do
			data[field.key] = CUSTOM_THEME[field.key]:ToHex()
		end

		local ok = pcall(function()
			writeFile(SAVE_FILE, HttpService:JSONEncode(data))
		end)
		return ok
	end

	deleteSavedStyle = function()
		if not canSave then
			return false
		end

		local ok = pcall(function()
			if deleteFile then
				if isFile(SAVE_FILE) then
					deleteFile(SAVE_FILE)
				end
			else
				writeFile(SAVE_FILE, "")
			end
		end)
		return ok
	end

	copyInvite = function()
		if not copyToClipboard then
			return false
		end
		local ok = pcall(copyToClipboard, INVITE_LINK)
		return ok
	end

	local savedColors, savedGradient = readSavedStyle()
	if savedColors then
		hasSavedStyle = true
		for key, color in pairs(savedColors) do
			CUSTOM_THEME[key] = color
		end
		CUSTOM_THEME.gradient = savedGradient
		refreshCustomDerived()
		currentTheme = CUSTOM_THEME
		customSeeded = true
	end
end

local function tweenColor(obj, prop, value, animate)
	if animate then
		TweenService:Create(obj, THEME_TWEEN, { [prop] = value }):Play()
	else
		obj[prop] = value
	end
end

local function tweenGradientColors(gradient, state, top, bottom, animate)
	if state.connection then
		state.connection:Disconnect()
		state.connection = nil
	end

	if not animate or not state.top then
		state.top = top
		state.bottom = bottom
		gradient.Color = ColorSequence.new(top, bottom)
		return
	end

	local fromTop = state.top
	local fromBottom = state.bottom
	local value = Instance.new("NumberValue")

	state.connection = value.Changed:Connect(function(alpha)
		state.top = fromTop:Lerp(top, alpha)
		state.bottom = fromBottom:Lerp(bottom, alpha)
		gradient.Color = ColorSequence.new(state.top, state.bottom)
	end)

	local tween = TweenService:Create(value, THEME_TWEEN, { Value = 1 })
	tween.Completed:Connect(function()
		value:Destroy()
	end)
	tween:Play()
end

local function onTheme(fn)
	table.insert(themeAppliers, fn)
	fn(currentTheme, false)
end

local function applyTheme(theme, instant)
	currentTheme = theme
	for _, fn in ipairs(themeAppliers) do
		fn(theme, not instant)
	end
end

local function addGradient(obj, top, bottom, rotation)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.new(top, top, top), Color3.new(bottom, bottom, bottom))
	gradient.Rotation = rotation or 90
	gradient.Parent = obj
	return gradient
end

local function shineSequence(base, shine)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, base),
		ColorSequenceKeypoint.new(0.38, base),
		ColorSequenceKeypoint.new(0.5, shine),
		ColorSequenceKeypoint.new(0.62, base),
		ColorSequenceKeypoint.new(1, base),
	})
end

local contentItems = {}
local shellItems = {}

local function registerFade(obj, props)
	table.insert(contentItems, { obj, props })
end

local function registerShellFade(obj, props)
	table.insert(shellItems, { obj, props })
end

local function fadeList(items, target, animate)
	for _, item in ipairs(items) do
		local obj, props = item[1], item[2]
		local goal = {}
		for prop in pairs(props) do
			goal[prop] = target
		end
		if animate then
			TweenService:Create(obj, TWEEN_INFO, goal):Play()
		else
			for prop, value in pairs(goal) do
				obj[prop] = value
			end
		end
	end
end

