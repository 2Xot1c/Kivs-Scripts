do
	local rowCount = 0
	local cardCount = 0

	local HUE_WHITE_END = 0.07
	local HUE_START = 0.09
	local HUE_STOPS = 11

	local function hueSequence()
		local keypoints = {
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(HUE_WHITE_END, Color3.new(1, 1, 1)),
		}
		for i = 0, HUE_STOPS do
			local position = HUE_START + (i / HUE_STOPS) * (1 - HUE_START)
			table.insert(keypoints, ColorSequenceKeypoint.new(position, Color3.fromHSV(i / HUE_STOPS, 1, 1)))
		end
		return ColorSequence.new(keypoints)
	end

	local function colorFromAlpha(alpha)
		if alpha < HUE_WHITE_END then
			return Color3.new(1, 1, 1)
		end
		local hue = math.clamp((alpha - HUE_START) / (1 - HUE_START), 0, 1)
		return Color3.fromHSV(hue, 1, 1)
	end

	local function alphaFromColor(color)
		local hue, saturation = color:ToHSV()
		if saturation < 0.2 then
			return HUE_WHITE_END / 2
		end
		return HUE_START + hue * (1 - HUE_START)
	end

