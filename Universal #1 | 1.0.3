do
	local ACQUIRE_RADIUS = 150
	local RELEASE_RADIUS = 200
	local SWITCH_MARGIN = 10
	local SMOOTHNESS = 0.15
	local BIND_NAME = "LockOnHead"

	local function getHead(plr)
		local char = plr.Character
		if not char then return nil end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local head = char:FindFirstChild("Head")
		if head and humanoid and humanoid.Health > 0 then
			return head
		end
		return nil
	end

	local function distanceFromCenter(camera, position)
		local pos, onScreen = camera:WorldToViewportPoint(position)
		if not onScreen then return nil end
		return (Vector2.new(pos.X, pos.Y) - camera.ViewportSize / 2).Magnitude
	end

	local function updateLock()
		local camera = workspace.CurrentCamera
		if not camera then return end

		local currentDist = nil
		if lockState.target then
			local head = getHead(lockState.target)
			currentDist = head and isInRange(lockState.target) and distanceFromCenter(camera, head.Position)
			if not currentDist or currentDist > RELEASE_RADIUS then
				lockState.target = nil
				currentDist = nil
			end
		end

		local bestPlayer = nil
		local bestDist = ACQUIRE_RADIUS
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local head = getHead(plr)
				if head and isInRange(plr) then
					local dist = distanceFromCenter(camera, head.Position)
					if dist and dist < bestDist then
						bestDist = dist
						bestPlayer = plr
					end
				end
			end
		end

		if bestPlayer and bestPlayer ~= lockState.target then
			if not lockState.target or bestDist + SWITCH_MARGIN < currentDist then
				lockState.target = bestPlayer
			end
		end

		if lockState.target then
			local head = getHead(lockState.target)
			if head then
				local goal = CFrame.lookAt(camera.CFrame.Position, head.Position)
				camera.CFrame = camera.CFrame:Lerp(goal, SMOOTHNESS)
			end
		end
	end

	local function setEnabled(value)
		if value then
			RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, updateLock)
		else
			RunService:UnbindFromRenderStep(BIND_NAME)
			lockState.target = nil
		end
	end

	local function setColor(color)
		lockState.lineColor = color
	end

	Players.PlayerRemoving:Connect(function(plr)
		if lockState.target == plr then
			lockState.target = nil
		end
	end)

	local card = createCard(list)
	createToggleRow(card, "Lock", setEnabled)
	createWarningRow(card)
	createHueRow(card, lockState.lineColor, setColor)
end

