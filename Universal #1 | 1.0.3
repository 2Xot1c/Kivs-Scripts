	local dragging = false
	local dragStart, startPos

	frame.InputBegan:Connect(function(input)
		if not unlocked then return end
		if isPressTypeInput(input) then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and isMoveTypeInput(input) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	local isOpen = false
	local toggleId = 0

	local function applyState(open, animate)
		isOpen = open
		toggleId += 1
		local myId = toggleId

		if not open then
			dragging = false
		else
			frame.Visible = true
		end

		local target = open and 0 or 1
		fadeList(shellItems, target, animate)
		if unlocked then
			fadeList(contentItems, target, animate)
		end

		if not animate then
			frame.Visible = open
			return
		end

		if not open then
			task.delay(TWEEN_INFO.Time, function()
				if myId == toggleId then
					frame.Visible = false
				end
			end)
		end
	end

	UserInputService.InputBegan:Connect(function(input)
