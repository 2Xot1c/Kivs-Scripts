	knob.Parent = switch
	registerFade(knob, { BackgroundTransparency = true })
	addGradient(knob, 1, 0.82, 90)

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(0.5, 0)
	knobCorner.Parent = knob

	onTheme(function(t, a)
		tweenColor(switch, "BackgroundColor3", state and t.on or t.off, a)
		tweenColor(knob, "BackgroundColor3", t.knob, a)
	end)

	local function showState()
		TweenService:Create(knob, SWITCH_TWEEN, {
			Position = state and KNOB_ON_POS or KNOB_OFF_POS,
		}):Play()
		TweenService:Create(switch, SWITCH_TWEEN, {
			BackgroundColor3 = state and currentTheme.on or currentTheme.off,
		}):Play()
	end

	switch.Activated:Connect(function()
		state = not state
		showState()
		callback(state)
	end)

	return function(value)
		state = value
		showState()
	end
end

