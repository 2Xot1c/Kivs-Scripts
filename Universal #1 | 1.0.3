do
	local DEFAULT_COLOR = Color3.fromRGB(255, 255, 255)
	local THICKNESS = 2

	local R15_BONES = {
		{ "Head", "UpperTorso" },
		{ "UpperTorso", "LowerTorso" },
		{ "UpperTorso", "LeftUpperArm" },
		{ "LeftUpperArm", "LeftLowerArm" },
		{ "LeftLowerArm", "LeftHand" },
		{ "UpperTorso", "RightUpperArm" },
		{ "RightUpperArm", "RightLowerArm" },
		{ "RightLowerArm", "RightHand" },
		{ "LowerTorso", "LeftUpperLeg" },
		{ "LeftUpperLeg", "LeftLowerLeg" },
		{ "LeftLowerLeg", "LeftFoot" },
		{ "LowerTorso", "RightUpperLeg" },
		{ "RightUpperLeg", "RightLowerLeg" },
		{ "RightLowerLeg", "RightFoot" },
	}

	local R6_BONES = {
		{ "Head", "Torso" },
		{ "Torso", "Left Arm" },
		{ "Torso", "Right Arm" },
		{ "Torso", "Left Leg" },
		{ "Torso", "Right Leg" },
	}

	local skeletonColor = DEFAULT_COLOR
	local skeletons = {}
	local skeletonConn

	local function createBoneLine()
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.BackgroundColor3 = skeletonColor
		line.BorderSizePixel = 0
		line.Visible = false
		line.Parent = overlayGui
		return line
	end

	local function removeSkeleton(plr)
		local bones = skeletons[plr]
		if bones then
			for _, line in ipairs(bones) do
				line:Destroy()
			end
			skeletons[plr] = nil
		end
	end

	local function updateSkeletons()
		local camera = workspace.CurrentCamera
		if not camera then return end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local bones = skeletons[plr]
				if not bones then
					bones = {}
					skeletons[plr] = bones
				end

				local char = plr.Character
				local layout = nil
				if char and isInRange(plr) then
					layout = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
				end

				local count = layout and #layout or 0

				for i = 1, count do
					local line = bones[i]
					if not line then
						line = createBoneLine()
						bones[i] = line
					end

					local a = char:FindFirstChild(layout[i][1])
					local b = char:FindFirstChild(layout[i][2])
					local shown = false

					if a and b then
						local from, fromFront = project(camera, a.Position)
						local to, toFront = project(camera, b.Position)
						if fromFront and toFront then
							placeLine(line, from, to, THICKNESS)
							shown = true
						end
					end

					line.Visible = shown
				end

				for i = count + 1, #bones do
					bones[i].Visible = false
				end
			end
		end
	end

	local function setEnabled(value)
		if value then
			if not skeletonConn then
				skeletonConn = RunService.RenderStepped:Connect(updateSkeletons)
			end
		else
			if skeletonConn then
				skeletonConn:Disconnect()
				skeletonConn = nil
			end
			for plr in pairs(skeletons) do
				removeSkeleton(plr)
			end
		end
	end

	local function setColor(color)
		skeletonColor = color
		for _, bones in pairs(skeletons) do
			for _, line in ipairs(bones) do
				line.BackgroundColor3 = color
			end
		end
	end

	Players.PlayerRemoving:Connect(removeSkeleton)

	local card = createCard(list)
	createToggleRow(card, "Skeleton ESP", setEnabled)
	createHueRow(card, DEFAULT_COLOR, setColor)
end

