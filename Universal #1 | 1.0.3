		addGradient(button, 1, 0.8, 90)
		onTheme(function(t, a)
			tweenColor(button, "BackgroundColor3", t.button, a)
			tweenColor(button, "TextColor3", t.text, a)
		end)

		local buttonCorner = Instance.new("UICorner")
		buttonCorner.CornerRadius = UDim.new(0, 9)
		buttonCorner.Parent = button

		button.Activated:Connect(callback)

		return button
	end
end

