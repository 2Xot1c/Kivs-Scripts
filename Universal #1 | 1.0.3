local skeletonColor = DEFAULT_SKELETON_COLOR
local skeletons = {}
local skeletonConn

local function createBoneLine()
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = skeletonColor
	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = overlayGui
	return line
end

local function removeSkeleton(plr)
	local bones = skeletons[plr]
	if bones then
		for _, line in ipairs(bones) do
			line:Destroy()
		end
		skeletons[plr] = nil
	end
end

local function updateSkeletons()
	local camera = workspace.CurrentCamera
	if not camera then return end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local bones = skeletons[plr]
			if not bones then
				bones = {}
				skeletons[plr] = bones
			end

			local char = plr.Character
			local layout = nil
			if char and isInRange(plr) then
				layout = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
			end

			local count = layout and #layout or 0

			for i = 1, count do
				local line = bones[i]
				if not line then
					line = createBoneLine()
					bones[i] = line
				end

				local a = char:FindFirstChild(layout[i][1])
				local b = char:FindFirstChild(layout[i][2])
				local shown = false

				if a and b then
					local from, fromFront = project(camera, a.Position)
					local to, toFront = project(camera, b.Position)
					if fromFront and toFront then
						placeLine(line, from, to, SKELETON_THICKNESS)
						shown = true
					end
				end

				line.Visible = shown
			end

			for i = count + 1, #bones do
				bones[i].Visible = false
			end
		end
	end
end

local function setSkeleton(enabled)
	if enabled then
		if not skeletonConn then
			skeletonConn = RunService.RenderStepped:Connect(updateSkeletons)
		end
	else
		if skeletonConn then
			skeletonConn:Disconnect()
			skeletonConn = nil
		end
		for plr in pairs(skeletons) do
			removeSkeleton(plr)
		end
	end
end

local function setSkeletonColor(color)
	skeletonColor = color
	for _, bones in pairs(skeletons) do
		for _, line in ipairs(bones) do
			line.BackgroundColor3 = color
		end
	end
end

local lockEnabled = false
local lockedTarget = nil
local lockedLineColor = DEFAULT_LOCKED_COLOR
local LOCK_BIND_NAME = "LockOnHead"

local function getHead(plr)
	local char = plr.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if head and humanoid and humanoid.Health > 0 then
		return head
	end
	return nil
end

local function distanceFromCenter(camera, position)
	local pos, onScreen = camera:WorldToViewportPoint(position)
	if not onScreen then return nil end
	return (Vector2.new(pos.X, pos.Y) - camera.ViewportSize / 2).Magnitude
end

local function updateLock()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local currentDist = nil
	if lockedTarget then
		local head = getHead(lockedTarget)
		currentDist = head and isInRange(lockedTarget) and distanceFromCenter(camera, head.Position)
		if not currentDist or currentDist > LOCK_RELEASE_RADIUS then
			lockedTarget = nil
			currentDist = nil
		end
	end

	local bestPlayer = nil
	local bestDist = LOCK_ACQUIRE_RADIUS
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local head = getHead(plr)
			if head and isInRange(plr) then
				local dist = distanceFromCenter(camera, head.Position)
				if dist and dist < bestDist then
					bestDist = dist
					bestPlayer = plr
				end
			end
		end
	end

	if bestPlayer and bestPlayer ~= lockedTarget then
		if not lockedTarget or bestDist + LOCK_SWITCH_MARGIN < currentDist then
			lockedTarget = bestPlayer
		end
	end

	if lockedTarget then
		local head = getHead(lockedTarget)
		if head then
			local goal = CFrame.lookAt(camera.CFrame.Position, head.Position)
			camera.CFrame = camera.CFrame:Lerp(goal, LOCK_SMOOTHNESS)
		end
	end
end

local function setLock(enabled)
	lockEnabled = enabled
	if enabled then
		RunService:BindToRenderStep(LOCK_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, updateLock)
	else
		RunService:UnbindFromRenderStep(LOCK_BIND_NAME)
		lockedTarget = nil
	end
end

local function setLockedLineColor(color)
	lockedLineColor = color
end

local linesEnabled = false
local lineColor = DEFAULT_LINE_COLOR
local lines = {}
local linesConn

local function getLine(plr)
	local line = lines[plr]
	if line then return line end

	line = Instance.new("Frame")
	line.Name = "Line_" .. plr.UserId
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = lineColor
	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = overlayGui
	lines[plr] = line
	return line
end

local function removeLine(plr)
	local line = lines[plr]
	if line then
		line:Destroy()
		lines[plr] = nil
	end
end

local function updateLines()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	local origin = Vector2.new(viewport.X / 2, viewport.Y)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local line = getLine(plr)
			local char = plr.Character
			local part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
			local shown = false

			if part and isInRange(plr) then
				local target, front = project(camera, part.Position)
				if front then
					placeLine(line, origin, target, LINE_THICKNESS)
					line.BackgroundColor3 = (plr == lockedTarget) and lockedLineColor or lineColor
					shown = true
				end
			end

			line.Visible = shown
		end
	end
end

local function setLines(enabled)
	linesEnabled = enabled

	if enabled then
		if not linesConn then
			linesConn = RunService.RenderStepped:Connect(updateLines)
		end
	else
		if linesConn then
			linesConn:Disconnect()
			linesConn = nil
		end
		for plr in pairs(lines) do
			removeLine(plr)
		end
	end
end

local function setLineColor(color)
	lineColor = color
end

local speedValue = DEFAULT_SPEED
local speedActive = false

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function setSpeed(value)
	speedValue = value
	speedActive = (value ~= DEFAULT_SPEED)

	local humanoid = getHumanoid()
	if humanoid then
		humanoid.WalkSpeed = value
	end
end

RunService.Heartbeat:Connect(function()
	if not speedActive then return end
	local humanoid = getHumanoid()
	if humanoid and humanoid.WalkSpeed ~= speedValue then
		humanoid.WalkSpeed = speedValue
	end
end)

local function trackPlayer(plr)
	if plr == player then return end
	if characterConns[plr] then return end

	characterConns[plr] = plr.CharacterAdded:Connect(function()
		if espEnabled then
			addHighlight(plr)
		end
	end)

	if espEnabled then
		addHighlight(plr)
	end
end

local function untrackPlayer(plr)
	if characterConns[plr] then
		characterConns[plr]:Disconnect()
		characterConns[plr] = nil
	end
	if lockedTarget == plr then
		lockedTarget = nil
	end
	removeHighlight(plr)
	removeLine(plr)
	removeBox(plr)
	removeSkeleton(plr)
	removeTag(plr)
end

for _, plr in ipairs(Players:GetPlayers()) do
	trackPlayer(plr)
end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(untrackPlayer)

