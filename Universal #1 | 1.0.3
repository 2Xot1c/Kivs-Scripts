do
	local DEFAULT_COLOR = Color3.fromRGB(255, 60, 60)
	local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

	local enabled = false
	local fillColor = DEFAULT_COLOR
	local highlights = {}
	local characterConns = {}
	local rangeConn

	local function removeHighlight(plr)
		local h = highlights[plr]
		if h then
			h:Destroy()
			highlights[plr] = nil
		end
	end

	local function addHighlight(plr)
		removeHighlight(plr)
		local char = plr.Character
		if not char then return end

		local h = Instance.new("Highlight")
		h.Name = "ChamsHighlight"
		h.FillColor = fillColor
		h.OutlineColor = OUTLINE_COLOR
		h.FillTransparency = 0.5
		h.OutlineTransparency = 0
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Enabled = isInRange(plr)
		h.Parent = char
		highlights[plr] = h
	end

	local function updateRange()
		for plr, h in pairs(highlights) do
			h.Enabled = isInRange(plr)
		end
	end

	local function trackPlayer(plr)
		if plr == player then return end
		if characterConns[plr] then return end

		characterConns[plr] = plr.CharacterAdded:Connect(function()
			if enabled then
				addHighlight(plr)
			end
		end)

		if enabled then
			addHighlight(plr)
		end
	end

	local function setEnabled(value)
		enabled = value

		if value then
			if not rangeConn then
				rangeConn = RunService.Heartbeat:Connect(updateRange)
			end
		elseif rangeConn then
			rangeConn:Disconnect()
			rangeConn = nil
		end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				if value then
					addHighlight(plr)
				else
					removeHighlight(plr)
				end
			end
		end
	end

	local function setColor(color)
		fillColor = color
		for _, h in pairs(highlights) do
			h.FillColor = color
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		trackPlayer(plr)
	end
	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(function(plr)
		if characterConns[plr] then
			characterConns[plr]:Disconnect()
			characterConns[plr] = nil
		end
		removeHighlight(plr)
	end)

	local card = createCard(list)
	createToggleRow(card, "Chams", setEnabled)
	createHueRow(card, DEFAULT_COLOR, setColor)
end

