local function createScrollPage(name, padding)
	local page = Instance.new("ScrollingFrame")
	page.Name = name
	page.Size = UDim2.new(1, -28, 1, -88)
	page.Position = UDim2.new(0, 14, 0, 54)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollingDirection = Enum.ScrollingDirection.Y
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 4
	page.ClipsDescendants = true
	page.Parent = frame
	registerFade(page, { ScrollBarImageTransparency = true })
	onTheme(function(t, a) tweenColor(page, "ScrollBarImageColor3", t.sub, a) end)

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = page

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.Padding = UDim.new(0, padding)
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Parent = page

	return page
end

