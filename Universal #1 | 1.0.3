local function panelColors(theme)
	if theme.custom then
		return theme.bg, theme.gradient and theme.bg2 or theme.bg
	end
	return theme.bg, theme.bg:Lerp(Color3.new(0, 0, 0), 0.2)
end

local CUSTOM_THEME = { name = "Custom", custom = true, gradient = true }
local customSeeded = false

local function refreshCustomDerived()
	CUSTOM_THEME.sub = CUSTOM_THEME.text:Lerp(CUSTOM_THEME.bg, 0.5)
	CUSTOM_THEME.cardStroke = CUSTOM_THEME.card:Lerp(CUSTOM_THEME.text, 0.2)
end

local function seedCustom(theme)
	local _, bottom = panelColors(theme)
	CUSTOM_THEME.bg = theme.bg
	CUSTOM_THEME.bg2 = bottom
	CUSTOM_THEME.card = theme.card
	CUSTOM_THEME.text = theme.text
	CUSTOM_THEME.on = theme.on
	CUSTOM_THEME.button = theme.button
	CUSTOM_THEME.off = theme.off
	CUSTOM_THEME.knob = theme.knob
	CUSTOM_THEME.outline = theme.outline
	CUSTOM_THEME.shine = theme.shine
	CUSTOM_THEME.gradient = true
	refreshCustomDerived()
end

