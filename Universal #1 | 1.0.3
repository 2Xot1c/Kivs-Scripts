		onTheme(function(t, a)
			tweenColor(switch, "BackgroundColor3", state and t.on or t.off, a)
			tweenColor(knob, "BackgroundColor3", t.knob, a)
		end)

		local function showState()
			TweenService:Create(knob, SWITCH_TWEEN, {
				Position = state and KNOB_ON_POS or KNOB_OFF_POS,
			}):Play()
