	errorLabel.Position = UDim2.new(0.5, 0, 0, 128)
	errorLabel.BackgroundTransparency = 1
	errorLabel.Text = ""
	errorLabel.TextColor3 = WARNING_COLOR
	errorLabel.TextSize = 14
	errorLabel.Font = Enum.Font.GothamBold
	errorLabel.Parent = frame

	local gateEntries = {
		{ box, { BackgroundTransparency = true, TextTransparency = true } },
		{ boxStroke, { Transparency = true } },
		{ linkLabel, { TextTransparency = true } },
		{ errorLabel, { TextTransparency = true } },
	}
	for _, entry in ipairs(gateEntries) do
		table.insert(shellItems, entry)
	end

	local finished = false
	local flashId = 0

	local function openGui()
		TweenService:Create(box, TWEEN_INFO, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		TweenService:Create(boxStroke, TWEEN_INFO, { Transparency = 1 }):Play()
		TweenService:Create(linkLabel, TWEEN_INFO, { TextTransparency = 1 }):Play()

		unlocked = true
		refreshOutline()
		header.Visible = true
		divider.Visible = true
		watermark.Visible = true
		versionLabel.Visible = true
		showPage("main")

		TweenService:Create(frame, EXPAND_TWEEN, {
			Size = UDim2.new(0, PANEL_WIDTH, 0, PANEL_HEIGHT),
		}):Play()
		fadeList(contentItems, isOpen and 0 or 1, true)

		task.delay(TWEEN_INFO.Time + 0.05, function()
			for _, entry in ipairs(gateEntries) do
				local index = table.find(shellItems, entry)
				if index then
					table.remove(shellItems, index)
				end
			end
			box:Destroy()
			linkLabel:Destroy()
			errorLabel:Destroy()
		end)
	end

	box.FocusLost:Connect(function(enterPressed)
		if finished or not enterPressed then return end

		local entered = box.Text:match("^%s*(.-)%s*$")
		flashId += 1

		if entered == ACCESS_KEY then
			finished = true
			errorLabel.Text = ""
			box.TextEditable = false
			setOutline(SUCCESS_COLOR, SUCCESS_SHINE)
			task.delay(1, openGui)
		else
			local myId = flashId
			errorLabel.Text = "Incorrect key. Access denied."
			box.Text = ""
			setOutline(FLASH_COLOR, FLASH_COLOR)

			task.delay(1, function()
				if flashId == myId and not finished then
					refreshOutline()
				end
			end)

			task.defer(function()
				if box.Parent then
					box:CaptureFocus()
				end
			end)
		end
	end)

	task.defer(function()
		if box.Parent then
			box:CaptureFocus()
		end
	end)
end

createKeyGate()

fadeList(contentItems, 1, false)
applyState(false, false)
applyState(true, true)
