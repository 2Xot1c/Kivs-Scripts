		box.BorderSizePixel = 0
		box.Visible = false
		box.Parent = overlayGui

		local stroke = Instance.new("UIStroke")
		stroke.Color = boxColor
		stroke.Thickness = THICKNESS
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = box

		boxes[plr] = box
		return box
	end

	local function removeBox(plr)
		local box = boxes[plr]
		if box then
			box:Destroy()
			boxes[plr] = nil
		end
	end

	local function updateBoxes()
		local camera = workspace.CurrentCamera
		if not camera then return end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local box = getBox(plr)
				local char = plr.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local head = char and char:FindFirstChild("Head")
				local shown = false

				if root and head and isInRange(plr) then
					local top, topFront = project(camera, head.Position + Vector3.new(0, head.Size.Y / 2 + 0.1, 0))
					local bottom, bottomFront = project(camera, root.Position - Vector3.new(0, 3, 0))
					local height = bottom.Y - top.Y

					if topFront and bottomFront and height > 2 then
						local width = height * 0.6
						box.Size = UDim2.fromOffset(width, height)
						box.Position = UDim2.fromOffset((top.X + bottom.X) / 2 - width / 2, top.Y)
						shown = true
					end
				end

				box.Visible = shown
			end
		end
	end

	local function setEnabled(value)
		if value then
			if not boxesConn then
				boxesConn = RunService.RenderStepped:Connect(updateBoxes)
			end
		else
