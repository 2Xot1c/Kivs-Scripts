	local function refreshCustomEditor()
		local color = CUSTOM_THEME[selectedField.key]
		previewSwatch.BackgroundColor3 = color
		hexLabel.Text = selectedField.label .. "  #" .. color:ToHex():upper()
		setRed(math.floor(color.R * 255 + 0.5))
		setGreen(math.floor(color.G * 255 + 0.5))
		setBlue(math.floor(color.B * 255 + 0.5))
		setGradientToggle(CUSTOM_THEME.gradient)

		for key, dot in pairs(dots) do
			dot.BackgroundColor3 = CUSTOM_THEME[key]
		end
		for key, stroke in pairs(fieldStrokes) do
			stroke.Thickness = (key == selectedField.key) and 2 or 0
		end
	end

	local function onChannel(channel, value)
		local color = CUSTOM_THEME[selectedField.key]
		local r = math.floor(color.R * 255 + 0.5)
		local g = math.floor(color.G * 255 + 0.5)
		local b = math.floor(color.B * 255 + 0.5)

		if channel == "r" then
			r = value
		elseif channel == "g" then
			g = value
		else
			b = value
		end

		local newColor = Color3.fromRGB(r, g, b)
		CUSTOM_THEME[selectedField.key] = newColor
		refreshCustomDerived()
		selectStyle(nil)
		applyTheme(CUSTOM_THEME, true)

		previewSwatch.BackgroundColor3 = newColor
		hexLabel.Text = selectedField.label .. "  #" .. newColor:ToHex():upper()
		dots[selectedField.key].BackgroundColor3 = newColor
	end

