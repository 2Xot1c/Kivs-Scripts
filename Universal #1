-- Dragging logic
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
	if isPressTypeInput(input) then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and isMoveTypeInput(input) then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- Toggle logic (fade in/out)
local isOpen = false
local toggleId = 0
local unlocked = false -- becomes true once the correct key has been entered

local function fadeTo(target, animate)
	for _, item in ipairs(fadeItems) do
		local obj, props = item[1], item[2]
		local goal = {}
		for prop in pairs(props) do
			goal[prop] = target
		end
		if animate then
			TweenService:Create(obj, TWEEN_INFO, goal):Play()
		else
			for prop, value in pairs(goal) do
				obj[prop] = value
			end
		end
	end
end

local function applyState(open, animate)
	isOpen = open
	toggleId += 1
	local myId = toggleId

	if not open then
		dragging = false
	else
		frame.Visible = true
	end

	fadeTo(open and 0 or 1, animate)

	if not animate then
		frame.Visible = open
		return
	end

	if not open then
		task.delay(TWEEN_INFO.Time, function()
			if myId == toggleId then
				frame.Visible = false
			end
		end)
	end
end

