-- Theme system: objects register a function that paints them with a theme
local currentTheme = THEMES[1]
for _, theme in ipairs(THEMES) do
	if theme.name == DEFAULT_STYLE then
		currentTheme = theme
	end
end
local themeAppliers = {}

local function tweenColor(obj, prop, value, animate)
	if animate then
		TweenService:Create(obj, THEME_TWEEN, { [prop] = value }):Play()
	else
		obj[prop] = value
	end
end

local function onTheme(fn)
	table.insert(themeAppliers, fn)
	fn(currentTheme, false)
end

local function applyTheme(theme)
	currentTheme = theme
	for _, fn in ipairs(themeAppliers) do
		fn(theme, true)
	end
end

-- Everything that needs to fade with the GUI gets registered here
local fadeItems = {}
local function registerFade(obj, props)
	table.insert(fadeItems, { obj, props })
end

-- Input helpers
local function isPressTypeInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMoveTypeInput(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

-- Distance helpers (used by the ESP and Lines range limits)
local function getOriginPosition()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		return root.Position
	end
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position
end

local function getDistanceTo(plr)
	local origin = getOriginPosition()
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not origin or not root then
		return nil
	end
	return (origin - root.Position).Magnitude
end

