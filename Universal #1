	if not unlocked then return end
	if input.KeyCode == TOGGLE_KEY and not UserInputService:GetFocusedTextBox() then
		applyState(not isOpen, true)
	end
end)

-- Key screen: a blank screen with only a text box. Press Enter to submit.
local function createKeyGate(onSuccess)
	local gateGui = Instance.new("ScreenGui")
	gateGui.Name = "KeyGate"
	gateGui.ResetOnSpawn = false
	gateGui.IgnoreGuiInset = true
	gateGui.DisplayOrder = 100
	gateGui.Parent = playerGui

	local cover = Instance.new("Frame")
	cover.Name = "Cover"
	cover.Size = UDim2.new(1, 0, 1, 0)
	cover.BackgroundColor3 = currentTheme.bg
	cover.BorderSizePixel = 0
	cover.Active = true -- blocks clicks from reaching anything behind it
	cover.Parent = gateGui

	local box = Instance.new("TextBox")
	box.Name = "KeyBox"
	box.Size = UDim2.new(0, 300, 0, 44)
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.new(0.5, 0, 0.5, 0)
	box.BackgroundColor3 = currentTheme.button
	box.BorderSizePixel = 0
	box.Text = ""
	box.PlaceholderText = "Enter key"
	box.PlaceholderColor3 = currentTheme.sub
	box.TextColor3 = currentTheme.knob
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 18
	box.ClearTextOnFocus = false
	box.Parent = cover

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 12)
	boxCorner.Parent = box

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = currentTheme.text
	boxStroke.Thickness = 2
	boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	boxStroke.Parent = box

	-- Shown only after a wrong key
	local errorLabel = Instance.new("TextLabel")
	errorLabel.Name = "Error"
	errorLabel.Size = UDim2.new(0, 300, 0, 20)
	errorLabel.AnchorPoint = Vector2.new(0.5, 0)
	errorLabel.Position = UDim2.new(0.5, 0, 0.5, 34)
	errorLabel.BackgroundTransparency = 1
	errorLabel.Text = ""
	errorLabel.TextColor3 = WARNING_COLOR
	errorLabel.TextSize = 14
	errorLabel.Font = Enum.Font.GothamBold
	errorLabel.Parent = cover

	local finished = false

	box.FocusLost:Connect(function(enterPressed)
		if finished or not enterPressed then return end

		local entered = box.Text:match("^%s*(.-)%s*$")

		if entered == ACCESS_KEY then
			finished = true
			errorLabel.Text = ""

			-- Fade the key screen away, then open the GUI
			local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(cover, fadeInfo, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(box, fadeInfo, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
			TweenService:Create(boxStroke, fadeInfo, { Transparency = 1 }):Play()

			onSuccess()

			task.delay(0.35, function()
				gateGui:Destroy()
			end)
		else
			-- Wrong key: say so, clear the box and let them try again
			errorLabel.Text = "Incorrect key. Access denied."
			box.Text = ""
			task.defer(function()
				if box.Parent then
					box:CaptureFocus()
				end
			end)
		end
	end)

	task.defer(function()
		if box.Parent then
			box:CaptureFocus()
		end
	end)
end

