	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row
	registerFade(label, { TextTransparency = true })
	onTheme(function(t, a) tweenColor(label, "TextColor3", t.text, a) end)

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Name = "Value"
	valueLabel.Size = UDim2.new(0, 56, 0, 22)
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.TextSize = 16
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = row
	registerFade(valueLabel, { TextTransparency = true })
	onTheme(function(t, a) tweenColor(valueLabel, "TextColor3", t.text, a) end)

	-- Slider area (inset so the knob never sticks out of the row)
	local area = Instance.new("Frame")
	area.Name = "SliderArea"
	area.Size = UDim2.new(1, -18, 0, 30)
	area.Position = UDim2.new(0, 9, 0, 24)
	area.BackgroundTransparency = 1
	area.Parent = row

	local range = maxValue - minValue
	local defaultAlpha = (defaultValue - minValue) / range

	-- Default marker (small line above the track)
	local marker = Instance.new("Frame")
	marker.Name = "DefaultMarker"
	marker.Size = UDim2.new(0, 2, 0, 8)
	marker.AnchorPoint = Vector2.new(0.5, 0)
	marker.Position = UDim2.new(defaultAlpha, 0, 0, 0)
	marker.BorderSizePixel = 0
	marker.Parent = area
	registerFade(marker, { BackgroundTransparency = true })
	onTheme(function(t, a) tweenColor(marker, "BackgroundColor3", t.text, a) end)

	local markerCorner = Instance.new("UICorner")
	markerCorner.CornerRadius = UDim.new(0.5, 0)
	markerCorner.Parent = marker

	-- Track
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 12)
	track.BorderSizePixel = 0
	track.Parent = area
	registerFade(track, { BackgroundTransparency = true })
	onTheme(function(t, a) tweenColor(track, "BackgroundColor3", t.off, a) end)

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(0.5, 0)
	trackCorner.Parent = track

	-- Filled part of the track
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(defaultAlpha, 0, 1, 0)
	fill.BorderSizePixel = 0
	fill.Parent = track
	registerFade(fill, { BackgroundTransparency = true })
	onTheme(function(t, a) tweenColor(fill, "BackgroundColor3", t.on, a) end)

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	-- Knob
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(defaultAlpha, 0, 0, 16)
	knob.BorderSizePixel = 0
	knob.ZIndex = 2
	knob.Parent = area
	registerFade(knob, { BackgroundTransparency = true })
	onTheme(function(t, a) tweenColor(knob, "BackgroundColor3", t.knob, a) end)

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(0.5, 0)
	knobCorner.Parent = knob

	local knobStroke = Instance.new("UIStroke")
	knobStroke.Thickness = 1
	knobStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	knobStroke.Parent = knob
	registerFade(knobStroke, { Transparency = true })
	onTheme(function(t, a) tweenColor(knobStroke, "Color", t.sub, a) end)

	-- Invisible button over the slider that captures the mouse
	-- (being a button also stops a press here from dragging the whole panel)
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Size = UDim2.new(1, 18, 1, 8)
	hit.Position = UDim2.new(0, -9, 0, -4)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.ZIndex = 3
	hit.Parent = area

	local function setValue(value)
		-- Snap to the default when close, so it's easy to go back to normal
		if math.abs(value - defaultValue) <= 1.5 then
			value = defaultValue
		end
		local alpha = (value - minValue) / range
		knob.Position = UDim2.new(alpha, 0, 0, 16)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		valueLabel.Text = tostring(value)
		callback(value)
	end

	local function updateFromX(x)
		local alpha = math.clamp((x - area.AbsolutePosition.X) / area.AbsoluteSize.X, 0, 1)
		setValue(math.floor(minValue + alpha * range + 0.5))
	end

	valueLabel.Text = tostring(defaultValue)

	local sliding = false

	hit.InputBegan:Connect(function(input)
		if isPressTypeInput(input) then
			sliding = true
			updateFromX(input.Position.X)

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and isMoveTypeInput(input) then
			updateFromX(input.Position.X)
		end
	end)
end

