-- Helper: creates a row of round color swatches (palette is optional)
local function createColorRow(name, defaultColor, callback, palette)
	palette = palette or COLOR_PALETTE
	rowCount += 1

	local row = Instance.new("Frame")
	row.Name = name .. "ColorRow"
	row.Size = UDim2.new(1, 0, 0, 28)
	row.BackgroundTransparency = 1
	row.LayoutOrder = rowCount
	row.Parent = list

	local rowLayout = Instance.new("UIListLayout")
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rowLayout.Padding = UDim.new(0, 8)
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Parent = row

	local strokes = {}

	local function select(selectedIndex)
		for i, stroke in ipairs(strokes) do
			stroke.Thickness = (i == selectedIndex) and 2 or 0
		end
	end

	local selectedIndex = 1
	for i, color in ipairs(palette) do
		if color == defaultColor then
			selectedIndex = i
		end
	end

	for i, color in ipairs(palette) do
		local swatch = Instance.new("TextButton")
		swatch.Name = "Swatch" .. i
		swatch.Size = UDim2.new(0, 24, 0, 24)
		swatch.BackgroundColor3 = color
		swatch.BorderSizePixel = 0
		swatch.Text = ""
		swatch.AutoButtonColor = false
		swatch.LayoutOrder = i
		swatch.Parent = row
		registerFade(swatch, { BackgroundTransparency = true })

		local swatchCorner = Instance.new("UICorner")
		swatchCorner.CornerRadius = UDim.new(0.5, 0)
		swatchCorner.Parent = swatch

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 0
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = swatch
		registerFade(stroke, { Transparency = true })
		onTheme(function(t, a) tweenColor(stroke, "Color", t.text, a) end)
		strokes[i] = stroke

		swatch.Activated:Connect(function()
			select(i)
			callback(color)
		end)
	end

	select(selectedIndex)
end

-- ESP logic (highlights are only enabled for players within ESP_MAX_DISTANCE studs)
local espEnabled = false
local espColor = DEFAULT_ESP_COLOR
local highlights = {}     -- [Player] = Highlight
local characterConns = {} -- [Player] = RBXScriptConnection
local espRangeConn

local function removeHighlight(plr)
	local h = highlights[plr]
	if h then
		h:Destroy()
		highlights[plr] = nil
	end
end

local function addHighlight(plr)
	removeHighlight(plr)
	local char = plr.Character
	if not char then return end

	local dist = getDistanceTo(plr)

	local h = Instance.new("Highlight")
	h.Name = "ESPHighlight"
	h.FillColor = espColor
	h.OutlineColor = ESP_OUTLINE_COLOR
	h.FillTransparency = 0.5
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Enabled = (dist ~= nil and dist <= ESP_MAX_DISTANCE)
	h.Parent = char
	highlights[plr] = h
end

-- Turns highlights on/off depending on how far each player is
local function updateESPRange()
	for plr, h in pairs(highlights) do
		local dist = getDistanceTo(plr)
		h.Enabled = (dist ~= nil and dist <= ESP_MAX_DISTANCE)
	end
end

local function trackPlayer(plr)
	if plr == player then return end
	if characterConns[plr] then return end

	characterConns[plr] = plr.CharacterAdded:Connect(function()
		if espEnabled then
			addHighlight(plr)
		end
	end)

	if espEnabled then
		addHighlight(plr)
	end
end

local function setESP(enabled)
	espEnabled = enabled

	if enabled then
		if not espRangeConn then
			espRangeConn = RunService.Heartbeat:Connect(updateESPRange)
		end
	else
		if espRangeConn then
			espRangeConn:Disconnect()
			espRangeConn = nil
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if enabled then
				addHighlight(plr)
			else
				removeHighlight(plr)
			end
		end
	end
end

local function setESPColor(color)
	espColor = color
	for _, h in pairs(highlights) do
		h.FillColor = color
	end
end

-- Lock logic (camera locks onto the head of the player nearest your crosshair)
local lockEnabled = false
local lockedTarget = nil -- Player currently locked onto (also read by Lines)
local lockedLineColor = DEFAULT_LOCKED_COLOR
local LOCK_BIND_NAME = "LockOnHead"

local function getHead(plr)
	local char = plr.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if head and humanoid and humanoid.Health > 0 then
		return head
	end
	return nil
end

local function distanceFromCenter(camera, position)
	local pos, onScreen = camera:WorldToViewportPoint(position)
	if not onScreen then return nil end
	return (Vector2.new(pos.X, pos.Y) - camera.ViewportSize / 2).Magnitude
end

local function updateLock()
	local camera = workspace.CurrentCamera
	if not camera then return end

	-- Distance of the current target from the center (nil if it should be dropped)
	local currentDist = nil
	if lockedTarget then
		local head = getHead(lockedTarget)
		currentDist = head and distanceFromCenter(camera, head.Position)
		if not currentDist or currentDist > LOCK_RELEASE_RADIUS then
			lockedTarget = nil
			currentDist = nil
		end
	end

	-- Find whoever is closest to the center of the screen right now
	local bestPlayer = nil
	local bestDist = LOCK_ACQUIRE_RADIUS
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local head = getHead(plr)
			if head then
				local dist = distanceFromCenter(camera, head.Position)
				if dist and dist < bestDist then
					bestDist = dist
					bestPlayer = plr
				end
			end
		end
	end

	-- Switch if there's no target, or someone else is clearly closer to center
	if bestPlayer and bestPlayer ~= lockedTarget then
		if not lockedTarget or bestDist + LOCK_SWITCH_MARGIN < currentDist then
			lockedTarget = bestPlayer
		end
	end

	-- Aim at the locked target's head
	if lockedTarget then
		local head = getHead(lockedTarget)
		if head then
			local goal = CFrame.lookAt(camera.CFrame.Position, head.Position)
			camera.CFrame = camera.CFrame:Lerp(goal, LOCK_SMOOTHNESS)
		end
	end
end

local function setLock(enabled)
	lockEnabled = enabled
	if enabled then
		RunService:BindToRenderStep(LOCK_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, updateLock)
	else
		RunService:UnbindFromRenderStep(LOCK_BIND_NAME)
		lockedTarget = nil
	end
end

local function setLockedLineColor(color)
	lockedLineColor = color
end

-- Lines logic (bottom middle of the screen -> players within LINES_MAX_DISTANCE studs)
local linesEnabled = false
local lineColor = DEFAULT_LINE_COLOR
local lines = {} -- [Player] = Frame
local linesConn

local function getLine(plr)
	local line = lines[plr]
	if line then return line end

	line = Instance.new("Frame")
	line.Name = "Line_" .. plr.Name
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = lineColor
	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = linesGui
	lines[plr] = line
	return line
end

local function removeLine(plr)
	local line = lines[plr]
	if line then
		line:Destroy()
		lines[plr] = nil
	end
end

local function updateLines()
	local camera = workspace.CurrentCamera
	if not camera then return end

	-- Every line starts from the bottom middle of the screen
	local viewport = camera.ViewportSize
	local origin = Vector2.new(viewport.X / 2, viewport.Y)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local line = getLine(plr)
			local char = plr.Character
			local part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
			local dist = getDistanceTo(plr)

			if part and dist and dist <= LINES_MAX_DISTANCE then
				local pos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local target = Vector2.new(pos.X, pos.Y)
					local delta = target - origin
					local mid = origin + delta / 2

					line.Size = UDim2.fromOffset(delta.Magnitude, LINE_THICKNESS)
					line.Position = UDim2.fromOffset(mid.X, mid.Y)
					line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					line.BackgroundColor3 = (plr == lockedTarget) and lockedLineColor or lineColor
					line.Visible = true
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end
		end
	end
end

local function setLines(enabled)
	linesEnabled = enabled

	if enabled then
		if not linesConn then
			linesConn = RunService.RenderStepped:Connect(updateLines)
		end
	else
		if linesConn then
			linesConn:Disconnect()
			linesConn = nil
		end
		for plr in pairs(lines) do
			removeLine(plr)
		end
	end
end

local function setLineColor(color)
	lineColor = color
end

-- Speed logic (sets your character's WalkSpeed from the slider)
